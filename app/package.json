{
  "name": "com.evnotify.app",
  "version": "2.5.0",
  "displayName": "EVNotify",
  "cordova": {
    "platforms": [
      "browser",
      "android"
    ],
    "plugins": {
      "cordova-plugin-android-permissions": {},
      "cordova-plugin-bluetooth-serial": {},
      "cordova-plugin-geolocation": {
        "GPS_REQUIRED": "true"
      },
      "uk.co.workingedge.phonegap.plugin.launchnavigator": {
        "LOCATION_USAGE_DESCRIPTION": "This app requires access to your location for navigation purposes",
        "GOOGLE_API_KEY_FOR_ANDROID": "replace-with-your-google-maps-api-key"
      },
      "cordova-plugin-autostart": {},
      "cordova-plugin-insomnia": {},
      "cordova-plugin-firebasex": {
        "ANDROID_FIREBASE_CORE_VERSION": "21.1.1",
        "ANDROID_FIREBASE_INSTALLATIONS_VERSION": "19.1.0",
        "ANDROID_GSON_VERSION": "2.14.0",
        "IOS_FIREBASE_SDK_VERSION": "12.14.0",
        "IOS_FIREBASE_SDK_BETA_VERSION": "12.14.0-beta",
        "IOS_STRIP_DEBUG": "false",
        "ANDROID_FIREBASE_ANALYTICS_VERSION": "23.0.0",
        "ANDROID_PLAY_SERVICES_TAGMANAGER_VERSION": "18.3.0",
        "IOS_GOOGLE_TAG_MANAGER_VERSION": "9.1.0",
        "FIREBASE_ANALYTICS_COLLECTION_ENABLED": "true",
        "FIREBASE_ANALYTICS_WITHOUT_ADS": "false",
        "GOOGLE_ANALYTICS_ADID_COLLECTION_ENABLED": "true",
        "GOOGLE_ANALYTICS_DEFAULT_ALLOW_ANALYTICS_STORAGE": "true",
        "GOOGLE_ANALYTICS_DEFAULT_ALLOW_AD_STORAGE": "true",
        "GOOGLE_ANALYTICS_DEFAULT_ALLOW_AD_USER_DATA": "true",
        "GOOGLE_ANALYTICS_DEFAULT_ALLOW_AD_PERSONALIZATION_SIGNALS": "true",
        "IOS_ON_DEVICE_CONVERSION_ANALYTICS": "false",
        "ANDROID_FIREBASE_MESSAGING_VERSION": "25.0.2",
        "ANDROID_ICON_ACCENT": "#FFFFFF",
        "FIREBASE_FCM_AUTOINIT_ENABLED": "true",
        "FIREBASE_MESSAGING_IMMEDIATE_PAYLOAD_DELIVERY": "false",
        "IOS_FCM_ENABLED": "true",
        "IOS_ENABLE_CRITICAL_ALERTS_ENABLED": "false",
        "ANDROID_FIREBASE_AUTH_VERSION": "24.1.0",
        "ANDROID_PLAY_SERVICES_AUTH_VERSION": "21.6.0",
        "ANDROID_CREDENTIALS_VERSION": "1.6.0",
        "ANDROID_GOOGLEID_VERSION": "1.2.0",
        "SETUP_RECAPTCHA_VERIFICATION": "false",
        "IOS_ENABLE_APPLE_SIGNIN": "false",
        "IOS_GOOGLE_SIGIN_VERSION": "9.0.0",
        "ANDROID_FIREBASE_CRASHLYTICS_VERSION": "20.0.6",
        "ANDROID_FIREBASE_CRASHLYTICS_NDK_VERSION": "20.0.6",
        "FIREBASE_CRASHLYTICS_COLLECTION_ENABLED": "true",
        "ANDROID_FIREBASE_PERF_VERSION": "22.0.5",
        "FIREBASE_PERFORMANCE_COLLECTION_ENABLED": "true",
        "ANDROID_FIREBASE_PERFORMANCE_MONITORING": "false",
        "ANDROID_FIREBASE_PERF_GRADLE_PLUGIN_VERSION": "2.0.2",
        "ANDROID_FIREBASE_FIRESTORE_VERSION": "26.3.0",
        "ANDROID_GRPC_OKHTTP": "1.81.0",
        "IOS_USE_PRECOMPILED_FIRESTORE_POD": "false",
        "ANDROID_FIREBASE_FUNCTIONS_VERSION": "22.1.1",
        "ANDROID_FIREBASE_CONFIG_VERSION": "23.1.0",
        "ANDROID_FIREBASE_INAPPMESSAGING_VERSION": "22.0.3"
      },
      "cordova-plugin-local-notification": {
        "ANDROIDX_CORE_VERSION": "1.12.0"
      },
      "cordova-plugin-background-mode": {},
      "cordova-plugin-device": "",
      "cordova-plugin-dialogs": {}
    }
  },
  "dependencies": {
    "babel-core": "^6.26.3",
    "babel-plugin-external-helpers": "^6.22.0",
    "babel-polyfill": "^6.26.0",
    "babel-preset-env": "^1.7.0",
    "chai": "^4.1.2",
    "cordova": "^13.0.0",
    "cordova-browser": "^7.0.0",
    "cordova-plugin-android-permissions": "^1.1.5",
    "cordova-plugin-autostart": "git+https://github.com/ToniKorin/cordova-plugin-autostart.git",
    "cordova-plugin-background-mode": "^0.7.3",
    "cordova-plugin-bluetooth-serial": "^0.4.7",
    "cordova-plugin-device": "^3.0.0",
    "cordova-plugin-dialogs": "^2.0.2",
    "cordova-plugin-firebasex": "^20.0.2",
    "cordova-plugin-geolocation": "^5.0.0",
    "cordova-plugin-insomnia": "git+https://github.com/EddyVerbruggen/Insomnia-PhoneGap-Plugin.git",
    "cordova-plugin-local-notification": "^1.2.3",
    "mocha": "^5.0.0",
    "moment": "^2.24.0",
    "rollup": "^1.32.1",
    "rollup-plugin-babel": "^3.0.7",
    "rollup-plugin-commonjs": "^9.1.3",
    "rollup-plugin-node-resolve": "^3.3.0",
    "rollup-plugin-serve": "^0.4.2",
    "rollup-plugin-vue": "^4.3.0",
    "uk.co.workingedge.phonegap.plugin.launchnavigator": "^5.0.7",
    "vue-resource": "^1.5.1",
    "vue-template-compiler": "^2.5.16"
  },
  "scripts": {
    "test": "mocha ../tests/*",
    "prepare:android": "node scripts/cordova-android.js prepare android",
    "build:android": "node scripts/cordova-android.js build android",
    "launch:android": "node scripts/cordova-android.js prepare android && node scripts/cordova-android.js run android ",
    "build:android:release": "node scripts/cordova-android.js build android --release"
  },
  "devDependencies": {
    "cordova-android": "^15.0.0"
  }
}
